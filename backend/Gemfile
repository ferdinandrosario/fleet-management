source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "= 8.1.3.1" # pin exact — backend/AGENTS.md "Version & stability"
# Use postgresql as the database for Active Record
gem "pg", "= 1.6.3"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", "= 8.0.2"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
# gem "jbuilder"

# Active Model has_secure_password (bcrypt) — SuperAdmin + tenant user auth.
gem "bcrypt", "= 3.1.22"

# JWT encode/decode for the custom token service (short-lived access +
# rotating refresh). Chosen over devise-jwt — see docs/feature/auth.md.
gem "jwt"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Use the database-backed adapters for Rails.cache, Active Job, and Action Cable
gem "solid_cache"
gem "solid_queue"
gem "solid_cable"

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Add HTTP asset caching/compression and X-Sendfile acceleration to Puma [https://github.com/basecamp/thruster/]
gem "thruster", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
gem "image_processing", "= 1.14.0"
gem "aws-sdk-s3", "= 1.228.2", require: false

# Cross-Origin Resource Sharing — locked to a strict allowlist (no "*").
gem "rack-cors"

# Multi-tenancy: schema-per-tenant isolation (one physical DB, one schema
# per owner). `require: "apartment"` — the gem name and require path differ.
gem "ros-apartment", "= 3.4.4", require: "apartment"

# Geospatial: PostGIS column types + spatial queries for vehicle discovery.
gem "activerecord-postgis-adapter"
gem "rgeo"

# Authorization: Pundit policies, default-deny.
gem "pundit"

# Edge security middleware.
gem "rack-attack"     # request throttling (auth / OTP / payments / search)
gem "secure_headers"  # CSP + security response headers

# OpenAPI / Swagger API Documentation
gem "ostruct"
gem "rswag-api", "= 2.17.0"
gem "rswag-ui", "= 2.17.0"

# Performance: mandatory pagination on every collection.
gem "pagy"

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Audits gems for known security defects (use config/bundler-audit.yml to ignore issues)
  gem "bundler-audit", require: false

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false

  # RSpec test stack (project-approved test gems — backend/AGENTS.md "Stack")
  gem "rspec-rails"
  gem "factory_bot_rails"
  gem "faker"

  # OpenAPI / Swagger specs generator
  gem "rswag-specs", "= 2.17.0"

  # N+1 / unused-eager-load detection — raises in dev/test (fails the build).
  gem "bullet"
end

group :test do
  # Model/association/validation matchers
  gem "shoulda-matchers"
  # Per-test DB cleaning (per-tenant strategy wired in Chunk B)
  gem "database_cleaner-active_record"
  # HTTP stubbing for external adapters (Razorpay, notifiers) — used from Session 4 on
  gem "webmock"
  gem "vcr"
  # Line-coverage gate (100% mandatory — backend/AGENTS.md "Coverage enforcement")
  gem "simplecov", require: false
end
