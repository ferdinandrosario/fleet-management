# Production Environment Configuration Blueprint

# --- Rails 8.1 API Environment ---
RAILS_ENV=production
SECRET_KEY_BASE=generate_with_bin_rails_secret
PORT=3000
APP_HOST=api.yourfleetdomain.com
ALLOWED_HOSTS=api.yourfleetdomain.com,admin.yourfleetdomain.com
CORS_ALLOWED_ORIGINS=https://admin.yourfleetdomain.com,https://yourfleetdomain.com

# --- PostgreSQL + PostGIS Multitenant Database ---
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=generate_secure_postgres_password
POSTGRES_DB=fleet_management_production
DATABASE_URL=postgres://fleet_admin:generate_secure_postgres_password@db:5432/fleet_management_production
DATABASE_MAX_THREADS=25

# --- Active Record PII Encryption (DPDP Act 2023) ---
AR_ENCRYPTION_PRIMARY_KEY=generate_secure_32_byte_primary_key
AR_ENCRYPTION_DETERMINISTIC_KEY=generate_secure_32_byte_deterministic_key
AR_ENCRYPTION_KEY_DERIVATION_SALT=generate_secure_32_byte_salt

# --- JWT Authentication Secrets ---
JWT_SECRET_KEY=generate_secure_jwt_hs256_secret_key

# --- Razorpay Production Credentials (20% Advance Payments) ---
RAZORPAY_KEY_ID=rzp_live_your_actual_merchant_key_id
RAZORPAY_KEY_SECRET=your_actual_merchant_key_secret

# --- Fast2SMS / Msg91 OTP API Credentials ---
FAST2SMS_API_KEY=your_actual_fast2sms_production_api_key

# --- AWS S3 / Cloudflare R2 ActiveStorage Bucket (Optional - Defaults to :local if unconfigured) ---
# ACTIVE_STORAGE_SERVICE=amazon
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET=fleet-management-production-assets

# --- Web Admin Vite Environment ---
VITE_API_URL=https://api.yourfleetdomain.com
