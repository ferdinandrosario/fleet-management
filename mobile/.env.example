# Copy to `.env` and adjust. Only EXPO_PUBLIC_* vars reach the JS bundle.
# Restart Metro with `npx expo start --clear` after changing values.

# Backend API base. The right value depends on where the app runs — see
# docs/getting-started/running-locally.md:
#   iOS Simulator / Expo web : http://localhost:3000
#   Android emulator         : http://10.0.2.2:3000
#   Physical device          : http://<your-Mac-LAN-IP>:3000  (run Rails with -b 0.0.0.0)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
