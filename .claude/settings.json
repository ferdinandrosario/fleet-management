{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote -v*)"
    ]
  },
  "skillListingMaxDescChars": 400,
  "skillListingBudgetFraction": 0.005,
  "autoCompactEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-todo.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for TODO comments"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-with-code.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
